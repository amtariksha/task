# ============================================================================
# Amtariksha Task Management System - Environment Variables
# ============================================================================
# Copy this file to apps/web/.env.local and fill in real values.
# DO NOT commit real values to git.

# ============================================================================
# Database (Supabase PostgreSQL) — REQUIRED
# ============================================================================
# Use Supabase's IPv4-compatible pooler hostname (aws-*.pooler.supabase.com).
# The old hostname (db.<project>.supabase.co) only has IPv6, which Vercel doesn't support.
# Find this in Supabase Dashboard → Project Settings → Database → Connection Pooling
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# ============================================================================
# Authentication — REQUIRED
# ============================================================================
# Random string used to sign JWTs. Generate with: openssl rand -base64 48
# REQUIRED — the app now refuses to start/verify tokens if this is unset.
JWT_SECRET=replace-with-a-long-random-secret

# ============================================================================
# OTP login (MSG91) — REQUIRED for OTP sign-in
# ============================================================================
# MSG91 auth key + OTP template id (the MSG91 template with an ##OTP## variable).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# Extra salt for hashing OTPs at rest (falls back to JWT_SECRET if unset).
OTP_HASH_SECRET=

# ============================================================================
# Credentials vault — REQUIRED for the project credentials feature
# ============================================================================
# 32-byte key for AES-256-GCM secret encryption. Generate with:
#   openssl rand -hex 32   (64 hex chars)  OR  openssl rand -base64 32
# Rotating this requires re-encrypting existing stored secrets.
ENCRYPTION_KEY=

# ============================================================================
# Email (Nodemailer / SMTP) — optional, required only if email features are used
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=Amtariksha
EMAIL_FROM_EMAIL=noreply@example.com
EMAIL_LOGO_URL=https://example.com/logo.png
EMAIL_ENABLED=true
EMAIL_TEST_MODE=false
EMAIL_DEBUG=false

# ============================================================================
# Application — optional
# ============================================================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# When set to 'true', suppresses verbose DB connection logs in production
NEXT_PUBLIC_GRAPHQL_ERROR_ONLY=true

# ============================================================================
# AWS S3 (file uploads) — optional, required only if attachments feature is used
# ============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ============================================================================
# Redis (caching) — optional
# ============================================================================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Push notifications (Expo Push API) — optional
# ============================================================================
# Expo access token (expo.dev → Account settings → Access tokens, in the account
# that owns the Expo project). When set, pushes are sent with
# "Authorization: Bearer <EXPO_ACCESS_TOKEN>"; when empty, no header is sent.
# REQUIRED once "Enhanced Security for Push Notifications" is enabled in Expo —
# without it every push is rejected with UNAUTHORIZED. Set it and redeploy
# BEFORE turning that on. Android delivery also needs the FCM V1 service-account
# key uploaded to Expo (DEPLOYMENT_GUIDE.md → Push Notifications).
EXPO_ACCESS_TOKEN=

# ============================================================================
# App Management API Key — REQUIRED for updating versions/maintenance via API (e.g. Postman)
# ============================================================================
APP_MANAGEMENT_API_KEY=karmayog_app_management_key_2026


# ============================================================================
# Scheduled jobs — REQUIRED in production for /api/cron/* (Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>"; middleware rejects cron calls if unset)
# ============================================================================
CRON_SECRET=

# ============================================================================
# Founder Start layer
# ============================================================================
# Extra founder employee ids (comma-separated). Platform admins are always
# founders; defaults to AM-0001 when empty.
FOUNDER_EMPLOYEE_IDS=
# Shared secret for ingestFounderActivity (Claude Code Stop hook, nightly git
# scan). Generate with: openssl rand -hex 32
FOUNDER_INGEST_TOKEN=
