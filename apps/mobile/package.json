{
  "name": "@karmayog/mobile",
  "version": "1.1.9",
  "private": true,
  "description": "Karmayog - React Native + Expo Mobile App",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "echo 'Use build:local or build:cloud for Android builds'",
    "build:local": "npx expo run:android --variant debug --no-bundler",
    "build:local:release": "npx expo run:android --variant release --no-bundler",
    "build:gradle:debug": "cd android && ./gradlew clean && ./gradlew assembleDebug --no-daemon",
    "build:gradle:release": "cd android && ./gradlew clean && ./gradlew assembleRelease --no-daemon",
    "build:cloud": "eas build --platform android --profile production",
    "build:cloud:preview": "eas build --platform android --profile preview",
    "install:local": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "install:local:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "uninstall": "adb uninstall com.karmayog",
    "reinstall:local": "npm run uninstall && npm run install:local",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test 'src/utils/__tests__/*.test.mjs'"
  },
  "dependencies": {
    "@apollo/client": "^4.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/drawer": "^7.7.2",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@react-navigation/stack": "^7.9.2",
    "apollo3-cache-persist": "^0.15.0",
    "date-fns": "^4.3.0",
    "expo": "~54.0.23",
    "expo-camera": "~17.0.9",
    "expo-constants": "^18.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-local-authentication": "~17.0.7",
    "expo-notifications": "~0.32.12",
    "expo-secure-store": "~15.0.7",
    "firebase": "^12.14.0",
    "graphql": "^16.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "0.5.1",
    "rxjs": "^7.8.2",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-native": "^0.72.8",
    "eslint": "^9",
    "typescript": "~5.9.2"
  },
  "expo": {
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ]
    ]
  }
}